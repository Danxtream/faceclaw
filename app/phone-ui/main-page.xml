<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="navigatingTo" loaded="loaded" unloaded="unloaded">
    <ActionBar title="Faceclaw">
        <ActionItem text="{{ buttonLabel }}" tap="{{ onTap }}" isEnabled="{{ canRun }}" android.position="popup" />
        <ActionItem text="Configure devices" tap="{{ onConfigureTap }}" isEnabled="{{ canRun }}" android.position="popup" />
        <ActionItem text="{{ showLogMenuLabel }}" tap="{{ onToggleLogTap }}" android.position="popup" />
    </ActionBar>

    <GridLayout>
        <GridLayout rows="auto,*" visibility="{{ portraitLayoutVisibility }}">
            <StackLayout row="0" visibility="{{ displayPreviewVisibility }}">
                <Image src="{{ displayPreview }}" stretch="fill" height="{{ displayPreviewHeight }}" />
            </StackLayout>
            <GridLayout row="1" rows="auto,auto,auto,*" class="p-20">
                <StackLayout row="0" class="m-b-8">
                    <StackLayout visibility="{{ evenAppConflictWarningVisibility }}">
                        <Label text="{{ evenAppConflictMessage }}" textWrap="true" />
                        <Button text="Open Even app settings" tap="{{ onOpenEvenAppSettingsTap }}" class="-primary" />
                    </StackLayout>
                    <Label text="{{ firmwareWarningMessage }}" textWrap="true" visibility="{{ firmwareWarningVisibility }}" />
                    <StackLayout visibility="{{ batteryOptimizationWarningVisibility }}">
                        <Label text="Android will slow Faceclaw to a crawl when the phone screen is off unless it is exempt from battery optimization." textWrap="true" />
                        <Button text="Allow unrestricted background usage" tap="{{ onAllowBackgroundUsageTap }}" class="-primary" />
                    </StackLayout>
                </StackLayout>
                <StackLayout row="1">
                    <GridLayout rows="auto,auto,auto" columns="*,*,*" class="m-t-8">
                        <Button row="0" col="1" text="Swipe up" tap="{{ onSyntheticUpTap }}" />
                        <Button row="1" col="0" text="Double-click" tap="{{ onSyntheticLeftTap }}" />
                        <Button row="1" col="2" text="Click" tap="{{ onSyntheticRightTap }}" />
                        <Button row="2" col="1" text="Swipe down" tap="{{ onSyntheticDownTap }}" />
                    </GridLayout>
                    <Button text="Save raw screenshot" tap="{{ onScreenshotTap }}" visibility="{{ screenshotButtonVisibility }}" />
                </StackLayout>
                <Label row="2" text="{{ status }}" class="m-t-16" textWrap="true" />
                <ScrollView id="logScrollView" row="3" class="m-t-16" visibility="{{ showLogVisibility }}">
                    <Label text="{{ log }}" textWrap="true" verticalAlignment="top" />
                </ScrollView>
            </GridLayout>
        </GridLayout>

        <GridLayout rows="auto,*" class="p-20" visibility="{{ landscapeLayoutVisibility }}">
            <StackLayout row="0" class="m-b-8">
                <StackLayout visibility="{{ evenAppConflictWarningVisibility }}">
                    <Label text="{{ evenAppConflictMessage }}" textWrap="true" />
                    <Button text="Open Even app settings" tap="{{ onOpenEvenAppSettingsTap }}" class="-primary" />
                </StackLayout>
                <Label text="{{ firmwareWarningMessage }}" textWrap="true" visibility="{{ firmwareWarningVisibility }}" />
                <StackLayout visibility="{{ batteryOptimizationWarningVisibility }}">
                    <Label text="Android will slow Faceclaw to a crawl when the phone screen is off unless it is exempt from battery optimization." textWrap="true" />
                    <Button text="Allow unrestricted background usage" tap="{{ onAllowBackgroundUsageTap }}" class="-primary" />
                </StackLayout>
            </StackLayout>
            <GridLayout row="1" rows="auto,auto,*" columns="*,260">
                <StackLayout row="0" col="0" visibility="{{ displayPreviewVisibility }}" horizontalAlignment="left">
                    <Image
                        src="{{ displayPreview }}"
                        stretch="fill"
                        width="{{ landscapeDisplayPreviewWidth }}"
                        height="{{ landscapeDisplayPreviewHeight }}" />
                </StackLayout>
                <StackLayout row="0" col="1" class="m-l-16">
                    <GridLayout rows="auto,auto,auto" columns="*,*,*">
                        <Button row="0" col="1" text="Swipe up" tap="{{ onSyntheticUpTap }}" />
                        <Button row="1" col="0" text="Double-click" tap="{{ onSyntheticLeftTap }}" />
                        <Button row="1" col="2" text="Click" tap="{{ onSyntheticRightTap }}" />
                        <Button row="2" col="1" text="Swipe down" tap="{{ onSyntheticDownTap }}" />
                    </GridLayout>
                    <Button text="Save raw screenshot" tap="{{ onScreenshotTap }}" visibility="{{ screenshotButtonVisibility }}" />
                </StackLayout>
                <Label row="1" col="0" colSpan="2" text="{{ status }}" class="m-t-16" textWrap="true" />
                <ScrollView id="logScrollViewLandscape" row="2" col="0" colSpan="2" class="m-t-16" visibility="{{ showLogVisibility }}">
                    <Label text="{{ log }}" textWrap="true" verticalAlignment="top" />
                </ScrollView>
            </GridLayout>
        </GridLayout>
        <StackLayout
            class="system-name-modal"
            visibility="{{ textSettingEditorVisibility }}"
            horizontalAlignment="stretch"
            verticalAlignment="top">
            <Label text="{{ activeTextSettingTitle }}" />
            <TextField
                id="settingsTextField"
                text="{{ activeTextSettingValue }}"
                textChange="{{ onTextSettingTextChange }}"
                returnPress="{{ onTextSettingReturnPress }}"
                autocorrect="false"
                autocapitalizationType="none"
                returnKeyType="done" />
        </StackLayout>
    </GridLayout>
</Page>
