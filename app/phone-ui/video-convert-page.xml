<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="navigatingTo" loaded="loaded" unloaded="unloaded">
    <ActionBar title="Convert video" />
    <GridLayout rows="auto,auto,auto,*" class="p-20">
        <StackLayout row="0">
            <Label text="Downloads/G2" class="h2" />
            <Label text="Only MP4 files without a same-name .h264/.264 are shown." textWrap="true" class="m-b-8" />
            <StackLayout visibility="{{ accessWarningVisibility }}">
                <Label text="Faceclaw needs All files access to read and write Downloads/G2." textWrap="true" />
                <Button text="Grant file access" tap="{{ onGrantAccessTap }}" class="-primary" />
            </StackLayout>
        </StackLayout>

        <StackLayout row="1" class="m-t-8">
            <Label text="{{ status }}" textWrap="true" />
            <Progress value="{{ progress }}" maxValue="100" />
            <Button text="Cancel conversion" tap="{{ onCancelTap }}" visibility="{{ cancelVisibility }}" />
        </StackLayout>

        <Label row="2" text="No unconverted MP4 files found." visibility="{{ emptyVisibility }}" class="m-t-16" />

        <ListView row="3" items="{{ files }}" itemTap="onFileTap" isEnabled="{{ listEnabled }}" class="m-t-12">
            <ListView.itemTemplate>
                <GridLayout rows="auto,auto" columns="*,auto" class="p-12">
                    <Label row="0" col="0" text="{{ name }}" textWrap="true" />
                    <Label row="1" col="0" text="Tap to choose FPS and convert" opacity="0.65" />
                </GridLayout>
            </ListView.itemTemplate>
        </ListView>
    </GridLayout>
</Page>
